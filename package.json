{
  "name": "document-verification-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Single-record document verification automation for Google Sheets, Drive, and Website A.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "node --import tsx src/index.ts",
    "single": "node --import tsx src/index.ts single",
    "auth:website": "node --import tsx src/index.ts auth:website",
    "fill:bsi-links": "node --import tsx src/scripts/fillBsiLinks.ts",
    "fill:bsi-links:dry-run": "node --import tsx src/scripts/fillBsiLinks.ts --dry-run",
    "fill:bsi-links:one": "node --import tsx src/scripts/fillBsiLinks.ts --limit=1",
    "fill:bsi-links:dry-run:one": "node --import tsx src/scripts/fillBsiLinks.ts --dry-run --limit=1",
    "fill:agent-columns": "node --import tsx src/scripts/fillAgentColumns.ts",
    "fill:agent-columns:dry-run": "node --import tsx src/scripts/fillAgentColumns.ts --dry-run",
    "fill:agent-columns:one": "node --import tsx src/scripts/fillAgentColumns.ts --limit=1",
    "fill:agent-columns:dry-run:one": "node --import tsx src/scripts/fillAgentColumns.ts --dry-run --limit=1",
    "drive:reown:dry-run": "node --import tsx src/scripts/reownDriveFoldersByCopy.ts",
    "drive:reown": "node --import tsx src/scripts/reownDriveFoldersByCopy.ts --confirm",
    "drive:reupload-files:dry-run": "node --import tsx src/scripts/reuploadDriveFiles.ts",
    "drive:reupload-files": "node --import tsx src/scripts/reuploadDriveFiles.ts --confirm",
    "docker:build": "docker build -t document-verification-automation .",
    "docker:start": "docker run --rm -it --env-file .env -v ./artifacts:/app/artifacts -v ./playwright:/app/playwright -v ./credentials:/app/credentials -v ${HOME}/.config/gcloud:/root/.config/gcloud:ro document-verification-automation"
  },
  "dependencies": {
    "@playwright/test": "^1.49.1",
    "dotenv": "^16.4.7",
    "googleapis": "^182.0.0",
    "openai": "^4.77.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
